# Copia a .env y ajusta. NUNCA commitear .env real ni exponer estos valores al frontend.
# Secretos server-side (ver dominio del build harness en CLAUDE.md).

# PostgreSQL
POSTGRES_USER=empleo
POSTGRES_PASSWORD=empleo_dev
POSTGRES_DB=empleabilidad

# LinkedIn OAuth2 (EP-001) — obtener de la app de LinkedIn Developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/auth/linkedin/callback

# Firma de sesión/JWT (EP-001)
JWT_SIGNING_KEY=

# LLM local (EP-003/EP-005) — endpoint del runtime local (p.ej. Ollama)
LLM_BASE_URL=http://host.docker.internal:11434
