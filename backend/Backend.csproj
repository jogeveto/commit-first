<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Empleabilidad.Api</RootNamespace>
  </PropertyGroup>

  <!--
    Scaffold del backend .NET Core (API + orquestación).
    Las dependencias (EF Core, Npgsql, autenticación) se agregan por slice,
    validadas contra .claude/config/stack-allowlist.json.
  -->

  <!-- El proyecto de tests vive en tests/ y NO forma parte del ensamblado del API. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
  </ItemGroup>

</Project>
