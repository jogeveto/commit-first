<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Empleabilidad.Api</RootNamespace>
  </PropertyGroup>

  <!--
    Dependencias agregadas por slice, justificadas contra el PRD §7 (stack) y el
    design.md del change. EP-001-a:
      · Npgsql — driver PostgreSQL (PRD §7 datos; design D3 provisión idempotente).
      · System.IdentityModel.Tokens.Jwt — sesión JWT HS256 (design D4).
  -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2" />
    <!-- EP-001-b: middleware de validación JWT (HU-003, design D4). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
  </ItemGroup>

  <!-- El proyecto de tests vive en tests/ y NO forma parte del ensamblado del API. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
  </ItemGroup>

</Project>
